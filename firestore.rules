rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // === Global Hardened Primitives ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Verified Admin RBAC check (Email Spoofing guarded by email_verified == true)
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'lourenco.consultorimob@gmail.com' ||
        request.auth.token.email == 'simuladorcorretorelite4.0@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // === Validation Blueprints (synchronized verbatim with firebase-blueprint.json) ===
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'provider', 'createdAt', 'updatedAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'provider', 'createdAt', 'updatedAt', 'lastLoginAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.role is string && data.role.size() <= 16 && data.role in ['user', 'admin']
        && data.provider is string && data.provider.size() <= 32 && data.provider == 'google'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    // === Collection: /users/{userId} (PII Isolated) ===
    match /users/{userId} {
      // PII Protection: only owner or verified admin can read individual user documents
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Pillar 8: Secure list query enforcing resource.data check with zero DB lookups
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Create: verified user creating own profile (no self-assigned admin unless already verified admin)
      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastLoginAt == request.time
        && (incoming().role == 'user' || isAdmin());

      // Action-Based Update: Validation helper wraps entire update logic
      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().provider == existing().provider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner syncing own Google profile/login metadata (cannot alter role)
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().email == request.auth.token.email
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt', 'lastLoginAt'])
          )
          ||
          // Action 2: Verified Admin updating role or metadata
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName', 'photoURL', 'updatedAt', 'lastLoginAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // === Collection: /admins/{userId} ===
    match /admins/{userId} {
      allow get: if isValidId(userId) && isAdmin();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == userId
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();

      allow update: if isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedBy'])
        && isAdmin();

      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
